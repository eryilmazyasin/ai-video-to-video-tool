# MongoDB Atlas connection details
MONGODB_USERNAME=
MONGODB_DB_NAME=
MONGODB_PASSWORD=
MONGODB_URI=

# Cloudinary account credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Uploadcare direct-upload credentials
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=your_public_key
UPLOADCARE_SECRET_KEY=your_secret_key

# Magic Hour server credentials
MAGIC_HOUR_API_KEY=your_api_key
MAGIC_HOUR_WEBHOOK_SECRET=your_webhook_secret

# Public deployment URL where the account-level Magic Hour webhook reaches this app
APP_URL=http://localhost:3000